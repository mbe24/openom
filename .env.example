# Copy to .env (gitignored) and adjust per machine. Read by scripts/cargo.mjs,
# scripts/vitest.mjs, and docker-compose.yml. A real environment variable always
# overrides what is set here.

# Where cargo runs — auto | local | docker
#   local  — cargo on the host (Linux / WSL / CI, where native builds work)
#   docker — cargo inside a Linux container (a host whose policy blocks executing
#            freshly built binaries: "Access is denied (os error 5)")
#   auto   — try local first, fall back to docker if the host build fails.
#            Note: on a locked-down host this triggers the host attempt (and its
#            policy popup) once before falling back — set `docker` to skip it.
OPENOM_RUNNER=docker

# Image used for docker/auto. The FULL image ships gcc, which rusqlite's `bundled`
# feature needs to compile SQLite; the -slim tag would fail at that step.
OPENOM_CARGO_IMAGE=rust:1-bookworm

# Host port the local server binds (docker-compose.yml). 8080 often clashes; 6060
# is a safe default (6000 is on browsers' blocked-ports list).
OPENOM_HTTP_PORT=6060
