# Copy to .env (gitignored) and adjust per machine. Read by scripts/cargo.mjs,
# scripts/vitest.mjs, apps/scripts/tauri.mjs, and docker-compose.yml. A real environment
# variable always overrides what is set here.

# JDK for the Tauri Android build ONLY (apps/scripts/tauri.mjs sets JAVA_HOME to this for the
# run, leaving your machine-wide JAVA_HOME alone). The generated project uses Gradle 8.14, which
# won't run on a JDK newer than 24 — point this at a compatible one, e.g. Android Studio's
# bundled JBR (a JDK 21). Leave unset to use your existing JAVA_HOME.
#   JAVA_HOME_JBR=C:\Program Files\Android\Android Studio\jbr

# Where cargo runs — auto | local | docker
#   local  — cargo on the host (Linux / WSL / CI, where native builds work)
#   docker — cargo inside a Linux container (a host whose policy blocks executing
#            freshly built binaries: "Access is denied (os error 5)")
#   auto   — try local first, fall back to docker if the host build fails.
#            Note: on a locked-down host this triggers the host attempt (and its
#            policy popup) once before falling back — set `docker` to skip it.
OPENOM_RUNNER=docker

# Image used for docker/auto. The FULL image ships gcc, which rusqlite's `bundled`
# feature needs to compile SQLite; the -slim tag would fail at that step.
OPENOM_CARGO_IMAGE=rust:1-bookworm

# Host port the local server binds (docker-compose.yml). 8080 often clashes; 6060
# is a safe default (6000 is on browsers' blocked-ports list).
OPENOM_HTTP_PORT=6060

# Local observability (grafana/otel-lgtm), OFF by default to spare the machine.
# Set BOTH to turn it on: the profile starts the LGTM container, the flag makes the
# server export to it. Then open Grafana at http://localhost:${OPENOM_GRAFANA_PORT}.
#   COMPOSE_PROFILES=observability
#   OPENOM_OTEL=1
COMPOSE_PROFILES=
OPENOM_OTEL=0
OPENOM_GRAFANA_PORT=3000
