node_modules/
dist/
target/
apps/src-tauri/gen/
.DS_Store

# WASM sealer build artifacts (scripts/build-sealer.mjs): the on-mount cargo target
# dir, the downloaded CLI, and the generated wasm-bindgen package (emitted under the
# web app's served root so the browser can fetch it without a bundler).
packages/openom-sealer/target-wasm/
packages/openom-sealer/tools/
apps/app/src/vendor/sealer/
packages/openom-treelog/target-wasm/
apps/app/src/vendor/treelog/
packages/openom-tree/target-wasm/
apps/app/src/vendor/tree/

# Per-machine runner config (scripts/cargo.mjs); .env.example is tracked.
.env

plan/

# Stray local pnpm store (host artifact); the real store lives in a Docker volume.
.pnpm-store/

# Playwright (runs locally on the host — browsers in ~/AppData/Local/ms-playwright)
apps/test-results/
apps/playwright-report/
apps/.last-run.json

# proptest failure-seed regressions (not tracked, matching repo convention)
proptest-regressions/
